# Co-SMOS environment configuration
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# IMPORTANT: Do NOT commit .env (it may contain secrets).

# Database
# Default (SQLite local file):
DATABASE_URL=sqlite:///./smos.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smos

# Auth tokens (optional — dev defaults used if empty)
# JULES_CONSULTANT_TOKEN=
# JULES_OPERATOR_TOKEN=
# JULES_ADMIN_TOKEN=

# Optional: author name for new tasks
# COSMOS_AUTHOR=operator
